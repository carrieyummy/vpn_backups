# 解决Codex插件reconnect且必须开tun的问题
# Cursor 的远程 extensionHost 是以 --useHostProxy=false 启动的，所以它没有继承宿主代理设置。Codex 又没有自己的代理环境变量，于是就直连了 所以只能通过配置环境变量解决
# 同时配置大小写和 ALL_PROXY，更稳一点

# 把这段配置添加到 ~/.bashrc中。必要时在linux图形界面配置网络代理

# 场景1/2 二选一

# 场景1：不配置局域网来源白名单，任何机器都可以使用本机的代理
# linux_mihomo/mihomo/config.yaml 设置 bind-address: "*" 时，VPN所在的机器用这个
# export HTTP_PROXY="http://127.0.0.1:7890"
# export HTTPS_PROXY="http://127.0.0.1:7890"
# export ALL_PROXY="http://127.0.0.1:7890"

# 场景2：需要配置局域网来源白名单，限定可用本机代理的机器 
# linux_mihomo/mihomo/config.yaml 设置 bind-address: "<MIHOMO_LAN_IP>" + lan-allowed-ips: "<LAN_CLIENT_IP>/32" 时，
# 场景3：局域网内其他机器使用本机代理时的配置
HTTP_PROXY=http://10.100.10.33:7890
HTTPS_PROXY=http://10.100.10.33:7890
ALL_PROXY=http://10.100.10.33:7890

http_proxy=http://10.100.10.33:7890
https_proxy=http://10.100.10.33:7890
all_proxy=http://10.100.10.33:7890

NO_PROXY=localhost,127.0.0.1,::1,10.0.0.0/8
no_proxy=localhost,127.0.0.1,::1,10.0.0.0/8